{
  "expo": {
    "name": "Tomorrow",
    "slug": "tomorrow",
    "version": "0.1.0",
    "scheme": "tomorrow",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.tomorrow",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.yourname.tomorrow",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#F3C242",
          "defaultChannel": "tomorrow"
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aecd429c-7f7d-40d0-bc53-f37cf92d3dd8"
      }
    }
  }
}
